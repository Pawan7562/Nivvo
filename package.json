{
  "name": "blinkwear-10min-fashion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "bundle:apk": "vite build && node scripts/prepare-standalone-apk.cjs",
    "build:apk": "npm run bundle:apk && cd expo-apk && npx eas-cli build -p android --profile preview",
    "build:playstore": "npm run bundle:apk && cd expo-apk && npx eas-cli build -p android --profile production"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.344.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
